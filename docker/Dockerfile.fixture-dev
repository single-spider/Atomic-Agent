# Development-only fixture validation image. NOT an approved ADR-012 locked image.
# Exact base-image digest and transitive wheel hashes remain a preflight requirement.
FROM python:3.12.15-slim
RUN python -m pip install --no-cache-dir \
    fastapi==0.128.2 \
    pydantic==2.13.5 \
    email-validator==2.3.0 \
    pytest==9.0.2 \
    httpx==0.28.1 \
    ruff==0.12.5 \
    bandit==1.8.6
RUN groupadd -g 65534 atomic || true
WORKDIR /work
# Actual checks run as UID 65534 by DockerRunner, with no runtime install/network.
